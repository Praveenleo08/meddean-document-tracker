# ==============================================================================
# MedDean Document Tracker - Environment Configuration Template
# Intelligent Administrative Communication & Pending Work Management System
# ==============================================================================

# Server Environment
PORT=5000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=super_secure_jwt_meddean_secret_key_2026_production
JWT_EXPIRES_IN=24h

# Python OCR Service
OCR_SERVICE_URL=http://127.0.0.1:8001

# ------------------------------------------------------------------------------
# Google Cloud Platform Integration (Drive API & Sheets API)
# ------------------------------------------------------------------------------

# Option A: Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=your_refresh_token

# Option B: Google Service Account Key (Alternative to OAuth 2.0)
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./config/google-service-account.json

# Google Drive Root Folder ID ('MedDean_Documents')
# Create a folder in Google Drive named 'MedDean_Documents' and paste its folder ID here:
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_google_drive_root_folder_id

# Google Spreadsheet ID ('MedDean_Communication_Register')
# Create a Google Spreadsheet named 'MedDean_Communication_Register' and paste its spreadsheet ID here:
GOOGLE_SHEET_ID=your_google_spreadsheet_id

# Note: If Google credentials are not set, MedDean operates seamlessly in
# Local Simulation Register & Storage Mode for instant local testing and evaluation!
